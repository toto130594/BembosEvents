    {
      "name": "02 - Administrador",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('correoAdmin') || !pm.environment.get('passwordAdmin')) {",
                  "    throw new Error('Completa correoAdmin y passwordAdmin en el Environment local');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login ADMINISTRADOR responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.token).to.exist;",
                  "pm.environment.set('tokenAdmin', json.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Listar todas las sedes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN ve sedes', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const sedes = pm.response.json();",
                  "pm.expect(sedes).to.be.an('array');",
                  "if (sedes.length > 0) {",
                  "    pm.environment.set('idSedeEncargado', sedes[0].idSede);",
                  "}",
                  "if (sedes.length > 1) {",
                  "    pm.environment.set('idOtraSede', sedes[1].idSede);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/backoffice/sedes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "backoffice",
                "sedes"
              ]
            }
          }
        },
        {
          "name": "Listar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN puede listar usuarios', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Crear encargado local",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const correo = `encargado.${Date.now()}@bembos.test`;",
                  "pm.environment.set('correoEncargado', correo);",
                  "if (!pm.environment.get('passwordEncargado')) {",
                  "    pm.environment.set('passwordEncargado', 'Encargado123!');",
                  "}",
                  "if (!pm.environment.get('idSedeEncargado')) {",
                  "    throw new Error('Ejecuta primero Listar todas las sedes');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN crea ENCARGADO_LOCAL', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('idUsuarioEncargado', json.idUsuario);",
                  "pm.expect(json.roles).to.include('ENCARGADO_LOCAL');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Encargado\",\n  \"apellidos\": \"Postman\",\n  \"correo\": \"{{correoEncargado}}\",\n  \"telefono\": \"999888777\",\n  \"password\": \"{{passwordEncargado}}\",\n  \"rol\": \"ENCARGADO_LOCAL\",\n  \"idSede\": {{idSedeEncargado}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Consultar encargado creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario encargado encontrado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.roles).to.include('ENCARGADO_LOCAL');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/{{idUsuarioEncargado}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "{{idUsuarioEncargado}}"
              ]
            }
          }
        }
      ]
    },
