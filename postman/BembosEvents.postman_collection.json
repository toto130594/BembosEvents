        {
          "name": "Ver mis sedes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ENCARGADO recibe exactamente una sede', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const sedes = pm.response.json();",
                  "    pm.expect(sedes).to.be.an('array');",
                  "    pm.expect(sedes.length).to.eql(1);",
                  "    pm.environment.set('idSedeEncargado', sedes[0].idSede);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEncargado}}",
                  "type": "string"
                }
