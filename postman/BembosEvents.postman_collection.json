              "raw": "{{baseUrl}}/api/backoffice/sedes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "backoffice",
                "sedes"
              ]
            }
          }
        },
        {
          "name": "Consultar mi sede - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ENCARGADO puede consultar su sede', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(String(json.idSede)).to.eql(String(pm.environment.get('idSedeEncargado')));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEncargado}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/backoffice/sedes/{{idSedeEncargado}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "backoffice",
                "sedes",
                "{{idSedeEncargado}}"
              ]
            }
          }
        },
