<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#1600d8" />

    <title>@ViewData["Title"] - Bembos Events</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />
<link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700&family=Montserrat:wght@500;700&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/bembos-events-r5.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bembos-events-r6.css" asp-append-version="true" />
</head>

<body>
    <a class="be-skip-link"
       href="#main-content">
        Saltar al contenido principal
    </a>

    <partial name="_Header" />

    <main class="be-main"
          id="main-content">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>