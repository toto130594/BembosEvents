<footer class="be-footer">
    <div class="be-footer-main">
        <div class="be-container be-footer-grid">

            <section class="be-footer-intro">
                <a class="be-r6-footer-brand"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="Bembos Events - Inicio">
                    <span class="be-r6-footer-logo-box">
                        <img src="~/images/bembos-events-r6/logo-bembos.svg"
                             alt="Bembos"
                             class="be-r6-footer-logo" />
                    </span>
                    <span class="be-r6-footer-events">EVENTS</span>
                </a>

                <p>
                    Convierte tu celebracion en una experiencia Bembos:
                    sede, salon, paquete, tematica y servicios en un solo flujo.
                </p>

                <a class="be-footer-cta"
                   asp-controller="Reserva"
                   asp-action="Index">
                    Reserva tu evento
                </a>
            </section>

            <section>
                <h2 class="be-footer-title">
                    Explora
                </h2>

                <ul class="be-footer-list">
                    <li>
                        <a class="be-footer-link"
                           asp-controller="Paquetes"
                           asp-action="Index">
                            Paquetes
                        </a>
                    </li>

                    <li>
                        <a class="be-footer-link"
                           asp-controller="Sedes"
                           asp-action="Index">
                            Locales
                        </a>
                    </li>

                    <li>
                        <a class="be-footer-link"
                           asp-controller="Tematicas"
                           asp-action="Index">
                            Tematicas
                        </a>
                    </li>

                    <li>
                        <a class="be-footer-link"
                           asp-controller="Servicios"
                           asp-action="Index">
                            Servicios
                        </a>
                    </li>
                </ul>
            </section>

            <section>
                <h2 class="be-footer-title">
                    Ayuda
                </h2>

                <ul class="be-footer-list">
                    <li>
                        <a class="be-footer-link"
                           asp-controller="Home"
                           asp-action="Privacy">
                            Privacidad
                        </a>
                    </li>

                    <li>
                        <a class="be-footer-link"
                           href="/health/backend">
                            Estado del servicio
                        </a>
                    </li>

                    <li>
                        <a class="be-footer-link"
                           asp-controller="Account"
                           asp-action="Login">
                            Mi cuenta
                        </a>
                    </li>
                </ul>
            </section>
        </div>
    </div>

    <div class="be-footer-bottom">
        <div class="be-container be-footer-bottom-content">
            <span>
                &copy; @DateTime.Now.Year Bembos Events.
            </span>

            <span>
                Portal de reservas para celebraciones.
            </span>
        </div>
    </div>
</footer>
