@model BembosEvents.Web.ViewModels.ReservationPaqueteViewModel

@{
    ViewData["Title"] = "Elige un paquete";
}

<section class="be-reservation-page">
    <div class="container">
        <header class="be-reservation-heading">
            <span class="be-reservation-step">
                Paso 5 de 9
            </span>

            <h1>Elige un paquete</h1>

            <p>
                Este paso es opcional.
                Los precios mostrados son informativos;
                el monto final lo calcula el sistema.
            </p>
        </header>

        <div class="be-reservation-progress">
            <span class="is-complete">Sede</span>
            <span class="is-complete">Salon</span>
            <span class="is-complete">Fecha</span>
            <span class="is-complete">Invitados</span>
            <span class="is-active">Paquete</span>
            <span>Tematica</span>
            <span>Servicios</span>
            <span>Resumen</span>
        </div>

        <form
            asp-controller="Reserva"
            asp-action="Paquete"
            method="post"
            class="be-reservation-form">

            @Html.AntiForgeryToken()

            <div
                asp-validation-summary="ModelOnly"
                class="text-danger mb-3">
            </div>

            <span
                asp-validation-for="IdPaquete"
                class="text-danger d-block mb-3">
            </span>

            <div class="be-reservation-options">
                <label class="be-reservation-option">
                    <input
                        type="radio"
                        name="IdPaquete"
                        value=""
                        checked="@(!Model.IdPaquete.HasValue)" />

                    <span class="be-reservation-option-body">
                        <strong>Sin paquete</strong>
                        <span>
                            Continuar sin seleccionar paquete.
                        </span>
                    </span>
                </label>

                @foreach (var paquete in Model.Paquetes)
                {
                    var selected =
                        Model.IdPaquete == paquete.IdPaquete;

                    <label class="be-reservation-option">
                        <input
                            type="radio"
                            name="IdPaquete"
                            value="@paquete.IdPaquete"
                            checked="@selected" />

                        <span class="be-reservation-option-body">
                            <strong>@paquete.Nombre</strong>

                            <span>
                                @paquete.Descripcion
                            </span>

                            <small>
                                Base para
                                @paquete.CantidadPersonasBase personas
                                - S/ @paquete.PrecioBase.ToString("N2")
                            </small>
                        </span>
                    </label>
                }
            </div>

            @if (Model.Paquetes.Count == 0)
            {
                <div class="be-reservation-info mt-3">
                    Actualmente no hay paquetes publicados.
                    Puedes continuar sin paquete.
                </div>
            }

            <div class="be-reservation-actions">
                <a
                    asp-controller="Reserva"
                    asp-action="Invitados"
                    class="btn btn-outline-secondary">
                    Volver
                </a>

                <button
                    type="submit"
                    class="btn be-btn-primary">
                    Continuar
                </button>
            </div>
        </form>
    </div>
</section>
