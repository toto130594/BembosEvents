@model BembosEvents.Web.ViewModels.ReservationSedeViewModel

@{
    ViewData["Title"] =
        "Elige un local";
}

<link rel="stylesheet"
      href="~/css/bembos-events-r3.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/r4-catalog.css"
      asp-append-version="true" />

<section class="be-reservation-page">
    <div class="container">
        <header class="be-reservation-heading">
            <span class="be-reservation-step">
                Paso 1 de 9
            </span>

            <h1>
                Elige el local para tu evento
            </h1>

            <p>
                AquÃ­ solo mostramos locales habilitados para eventos.
                En el siguiente paso podrÃ¡s elegir el espacio disponible.
            </p>

            @if (Model.Sedes.Count > 0)
            {
                <div class="be-r4-reservation-count">
                    <strong>
                        @Model.Sedes.Count
                    </strong>

                    <span>
                        locales disponibles para reservar
                    </span>
                </div>
            }
        </header>

        <div class="be-reservation-progress"
             aria-label="Progreso de reserva">
            <span class="is-active">Sede</span>
            <span>SalÃ³n</span>
            <span>Fecha</span>
            <span>Invitados</span>
            <span>Paquete</span>
            <span>TemÃ¡tica</span>
            <span>Servicios</span>
            <span>Resumen</span>
        </div>

        @if (Model.Sedes.Count == 0)
        {
            <div class="be-reservation-empty"
                 role="status">
                <h2>
                    No hay locales disponibles para eventos
                </h2>

                <p>
                    En este momento no encontramos locales habilitados
                    para iniciar una reserva. IntÃ©ntalo nuevamente mÃ¡s adelante.
                </p>

                <a asp-controller="Sedes"
                   asp-action="Index"
                   class="btn be-btn-primary">
                    Ver todos los locales
                </a>
            </div>
        }
        else
        {
            <form asp-controller="Reserva"
                  asp-action="Sede"
                  method="post"
                  class="be-reservation-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <span asp-validation-for="IdSede"
                      class="text-danger d-block mb-3">
                </span>

                <div class="be-reservation-options">
                    @foreach (
                        var sede in
                        Model.Sedes
                            .Where(
                                sede =>
                                    sede.PermiteEventos)
                            .OrderBy(
                                sede =>
                                    sede.Distrito)
                            .ThenBy(
                                sede =>
                                    sede.Nombre))
                    {
                        var selected =
                            Model.IdSede ==
                            sede.IdSede;

                        <label for="sede-@sede.IdSede"
                               class="be-reservation-option @(selected ? "is-selected" : string.Empty)">

                            <input id="sede-@sede.IdSede"
                                   type="radio"
                                   name="IdSede"
                                   value="@sede.IdSede"
                                   checked="@selected" />

                            <span class="be-reservation-option-body">
                                <span class="be-r4-reservation-status">
                                    Disponible para eventos
                                </span>

                                <strong>
                                    @sede.Nombre
                                </strong>

                                <span>
                                    @sede.Direccion
                                </span>

                                @if (!string.IsNullOrWhiteSpace(sede.Distrito))
                                {
                                    <small>
                                        @sede.Distrito
                                    </small>
                                }
                            </span>
                        </label>
                    }
                </div>

                <div class="be-reservation-actions">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Volver
                    </a>

                    <button type="submit"
                            class="btn be-btn-primary">
                        Continuar con salÃ³n
                    </button>
                </div>
            </form>
        }
    </div>
</section>

<script src="~/js/bembos-events-r3.js"
        asp-append-version="true"></script>