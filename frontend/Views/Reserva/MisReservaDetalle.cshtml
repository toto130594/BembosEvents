@model BembosEvents.Web.ViewModels.ReservaDetalleViewModel
@inject BembosEvents.Web.Services.IBackendApiClient BackendApiClient

@{
    // RESERVA_PAYMENT_SUMMARY_DATA
    var pagosResult =
        await BackendApiClient.GetPagosReservaAsync(
            Model.IdReserva);

    var pagosAprobados =
        (pagosResult.Data ??
            Array.Empty<BembosEvents.Web.Models.Api.PagoDto>())
        .Where(
            pago =>
                string.Equals(
                    pago.EstadoPago,
                    "APROBADO",
                    StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(
            pago =>
                pago.FechaPago ??
                pago.FechaCreacion)
        .ToArray();

    var totalAprobado =
        pagosAprobados.Sum(
            pago =>
                pago.Monto);

    var pagadoAplicado =
        Math.Min(
            Model.MontoTotal,
            totalAprobado);

    var saldoPendiente =
        Math.Max(
            0m,
            Model.MontoTotal -
            totalAprobado);

    var excesoPagado =
        Math.Max(
            0m,
            totalAprobado -
            Model.MontoTotal);

    var estadoFinanciero =
        saldoPendiente <= 0m
            ? "PAGADO"
            : totalAprobado > 0m
                ? "PAGO_PARCIAL"
                : "SIN_PAGO";

    var puedePagar =
        saldoPendiente > 0m &&
        (
            string.Equals(
                Model.Estado,
                "PENDIENTE",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                Model.Estado,
                "CONFIRMADA",
                StringComparison.OrdinalIgnoreCase)
        );

    var saldoHtml =
        saldoPendiente.ToString(
            "0.00",
            System.Globalization.CultureInfo.InvariantCulture);

    ViewData["Title"] = "Detalle de reserva";

    var statusClass =
        Model.Estado?.ToUpperInvariant() switch
        {
            "CONFIRMADA" => "is-confirmed",
            "CANCELADA" => "is-cancelled",
            "COMPLETADA" => "is-completed",
            _ => "is-pending"
        };
    var puedeCancelar =
        string.Equals(
            Model.Estado,
            "PENDIENTE",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(
            Model.Estado,
            "CONFIRMADA",
            StringComparison.OrdinalIgnoreCase);
}

<section class="be-my-reservations-page">
    <div class="container">
        <div class="be-detail-back">
            <a
                asp-controller="Reserva"
                asp-action="MisReservas">
                &larr; Volver a mis reservas
            </a>
        </div>

        <header class="be-my-reservations-heading">
            <span class="be-reservation-code">
                @Model.CodigoReserva
            </span>

            <div class="be-detail-title-row">
                <h1>Detalle de reserva</h1>

                <span class="be-reservation-status @statusClass">
                    @Model.Estado
                </span>
            </div>
        </header>

        @if (TempData["ReservationSuccess"] is string reservationSuccess)
        {
            <div class="alert alert-success be-reservation-feedback">
                @reservationSuccess
            </div>
        }

        @if (TempData["ReservationError"] is string reservationError)
        {
            <div class="alert alert-danger be-reservation-feedback">
                @reservationError
            </div>
        }
        <div class="be-reservation-detail-grid">
            <section class="be-reservation-detail-card">
                <h2>Evento</h2>

                <dl>
                    <div>
                        <dt>Sede</dt>
                        <dd>@Model.SedeNombre</dd>
                    </div>

                    <div>
                        <dt>Salon</dt>
                        <dd>@Model.SalonNombre</dd>
                    </div>

                    <div>
                        <dt>Fecha</dt>
                        <dd>
                            @Model.FechaEvento.ToString("dd/MM/yyyy")
                        </dd>
                    </div>

                    <div>
                        <dt>Horario</dt>
                        <dd>
                            @Model.HoraInicio.ToString("HH:mm")
                            -
                            @Model.HoraFin.ToString("HH:mm")
                        </dd>
                    </div>

                    <div>
                        <dt>Invitados</dt>
                        <dd>@Model.CantidadInvitados</dd>
                    </div>
                </dl>
            </section>

            <section class="be-reservation-detail-card">
                <h2>Configuracion</h2>

                <dl>
                    <div>
                        <dt>Paquete</dt>
                        <dd>
                            @(Model.PaqueteNombre ?? "Sin paquete")
                        </dd>
                    </div>

                    <div>
                        <dt>Tematica</dt>
                        <dd>
                            @(Model.TematicaNombre ?? "Sin tematica")
                        </dd>
                    </div>
                </dl>

                <h3>Servicios adicionales</h3>

                @if (Model.Servicios.Count == 0)
                {
                    <p class="be-detail-muted">
                        Sin servicios adicionales.
                    </p>
                }
                else
                {
                    <ul class="be-detail-services">
                        @foreach (var servicio in Model.Servicios)
                        {
                            <li>
                                <div>
                                    <strong>
                                        @servicio.Nombre
                                    </strong>

                                    <span>
                                        Cantidad:
                                        @servicio.Cantidad
                                    </span>
                                </div>

                                <div class="be-detail-service-price">
                                    <span>
                                        S/ @servicio.PrecioUnitario.ToString("N2")
                                        c/u
                                    </span>

                                    <strong>
                                        S/ @servicio.Subtotal.ToString("N2")
                                    </strong>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="be-reservation-detail-card be-reservation-money-card">
                <h2>Resumen de la reserva</h2>

                <dl>
                    <div>
                        <dt>Monto base</dt>
                        <dd>
                            S/ @Model.MontoBase.ToString("N2")
                        </dd>
                    </div>

                    <div>
                        <dt>Servicios</dt>
                        <dd>
                            S/ @Model.MontoServicios.ToString("N2")
                        </dd>
                    </div>

                    <div class="is-total">
                        <dt>Total</dt>
                        <dd>
                            S/ @Model.MontoTotal.ToString("N2")
                        </dd>
                    </div>

                    <div>
                        <dt>Porcentaje de deposito</dt>
                        <dd>
                            @Model.PorcentajeDeposito.ToString("N2") %
                        </dd>
                    </div>

                    <div class="is-deposit">
                        <dt>Deposito minimo requerido para confirmar</dt>
                        <dd>
                            S/ @Model.MontoDeposito.ToString("N2")
                        </dd>
                    </div>
                </dl>

                <p class="be-detail-authority-note">
                    Estos importes provienen de Spring Boot y son
                    el detalle actualizado de tu reserva.
                </p>
            </section>
        </div>

        @if (puedeCancelar)
        {
            <!-- RESERVA_PAYMENT_SUMMARY_UI -->
<section class="be-reservation-finance">

    <div class="be-reservation-finance-header">
        <div>
            <span class="be-finance-eyebrow">
                Pagos
            </span>

            <h2>
                Estado de cuenta
            </h2>
        </div>

        @if (estadoFinanciero == "PAGADO")
        {
            <span class="be-finance-status be-finance-status-paid">
                Pagado
            </span>
        }
        else if (estadoFinanciero == "PAGO_PARCIAL")
        {
            <span class="be-finance-status be-finance-status-partial">
                Pago parcial
            </span>
        }
        else
        {
            <span class="be-finance-status">
                Pendiente
            </span>
        }
    </div>

    <div class="be-finance-summary">

        <div class="be-finance-summary-item">
            <span>Total de la reserva</span>

            <strong>
                S/ @Model.MontoTotal.ToString("N2")
            </strong>
        </div>

        <div class="be-finance-summary-item">
            <span>Pagado aplicado</span>

            <strong>
                S/ @pagadoAplicado.ToString("N2")
            </strong>
        </div>

        <div class="be-finance-summary-item be-finance-summary-balance">
            <span>Saldo pendiente</span>

            <strong>
                S/ @saldoPendiente.ToString("N2")
            </strong>
        </div>

    </div>

    @if (excesoPagado > 0m)
    {
        <div class="be-finance-overpayment">
            <strong>
                Exceso registrado:
                S/ @excesoPagado.ToString("N2")
            </strong>

            <span>
                Este exceso corresponde a pagos de prueba ya
                aprobados. No se contabiliza como deuda pendiente.
            </span>
        </div>
    }

    @if (puedePagar)
    {
        <div class="be-finance-pay">

            <div class="be-finance-pay-copy">
                <h3>
                    Realizar un pago
                </h3>

                <p>
                    Puedes abonar cualquier monto hasta el saldo
                    pendiente de la reserva.
                </p>
            </div>

            <form asp-controller="MercadoPago"
                  asp-action="Checkout"
                  method="post"
                  class="be-finance-pay-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="IdReserva"
                       value="@Model.IdReserva" />

                <div class="be-finance-pay-field">
                    <label for="Monto">
                        Monto a pagar
                    </label>

                    <div class="be-finance-money-input">
                        <span>S/</span>

                        <input id="Monto"
                               name="Monto"
                               type="number"
                               min="0.01"
                               max="@saldoHtml"
                               step="0.01"
                               value="@saldoHtml"
                               required />
                    </div>

                    <small>
                        Máximo disponible:
                        S/ @saldoPendiente.ToString("N2")
                    </small>
                </div>

                <button type="submit"
                        class="be-finance-pay-button">
                    Realizar pago con Mercado Pago
                </button>

            </form>

        </div>
    }
    else if (saldoPendiente <= 0m)
    {
        <div class="be-finance-complete">
            <strong>
                ✓ La reserva no tiene saldo pendiente.
            </strong>
        </div>
    }

    <div class="be-finance-history">

        <h3>
            Historial de pagos
        </h3>

        @if (pagosAprobados.Length == 0)
        {
            <p class="be-finance-empty">
                Todavía no tienes pagos acreditados para esta reserva.
            </p>
        }
        else
        {
            <div class="be-finance-table-wrap">

                <table class="be-finance-table">

                    <thead>
                        <tr>
                            <th>Pago</th>
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var pago in pagosAprobados)
                        {
                            <tr>
                                <td>
                                    #@pago.IdPago
                                </td>

                                <td>
                                    @(pago.FechaPago
                                        ?.ToString("dd/MM/yyyy HH:mm")
                                        ?? pago.FechaCreacion
                                            .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    S/ @pago.Monto.ToString("N2")
                                </td>

                                <td>
                                    <span class="be-finance-approved">
                                        APROBADO
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>

<section class="be-reservation-cancel-panel">
                <div>
                    <h2>Cancelar reserva</h2>

                    <p>
                        La cancelacion cambiara el estado de la reserva
                        a CANCELADA. Esta operacion no realiza
                        reembolsos automaticamente.
                    </p>
                </div>

                <form
                    asp-controller="Reserva"
                    asp-action="CancelarPropia"
                    asp-route-idReserva="@Model.IdReserva"
                    method="post"
                    onsubmit="return confirm('¿Seguro que deseas cancelar esta reserva?');">

                    @Html.AntiForgeryToken()

                    <button
                        type="submit"
                        class="btn be-btn-danger">
                        Cancelar reserva
                    </button>
                </form>
            </section>
        }
        <div class="be-detail-metadata">
            <span>
                Reserva creada:
                @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
            </span>

            <span>
                Ultima actualizacion:
                @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>
    </div>
</section>

<section class="be-payment-link-panel">
    <div class="d-flex flex-column flex-md-row gap-3 align-items-md-center justify-content-md-between">
        <div>
            <strong>Pagos de la reserva</strong>

            <p class="mb-0 text-muted">
                Consulta el historial de pagos asociado a esta reserva.
            </p>
        </div>

        <a asp-controller="Pago"
           asp-action="PagosReserva"
           asp-route-idReserva="@Model.IdReserva"
           class="btn btn-outline-primary">
            Ver pagos
        </a>
    </div>
</section>
