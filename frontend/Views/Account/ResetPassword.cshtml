@model BembosEvents.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contrasena";
}

<section class="be-auth-page">
    <div class="be-container be-auth-layout">

        <div class="be-auth-promo">
            <span class="be-auth-kicker">
                Bembos Events
            </span>

            <h1>
                Crea una nueva contrasena
            </h1>

            <p>
                Usa el token recibido y define una nueva contrasena
                para recuperar el acceso a tu cuenta.
            </p>

            <ul class="be-auth-benefits">
                <li>
                    El token puede utilizarse una sola vez.
                </li>

                <li>
                    La nueva contrasena debe tener al menos 8 caracteres.
                </li>

                <li>
                    Las sesiones anteriores seran revocadas.
                </li>
            </ul>
        </div>

        <div class="be-auth-card">

            <div class="be-auth-card-heading">
                <span>
                    Seguridad
                </span>

                <h2>
                    Restablecer contrasena
                </h2>

                <p>
                    Ingresa el token recibido y tu nueva contrasena.
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post"
                  class="be-auth-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="be-form-summary"
                     role="alert">
                </div>

                <div class="be-form-field">
                    <label asp-for="Token"
                           class="be-form-label">
                    </label>

                    <input asp-for="Token"
                           class="be-form-control"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="Pega el token recibido" />

                    <span asp-validation-for="Token"
                          class="be-form-error">
                    </span>
                </div>

                <div class="be-form-field">
                    <label asp-for="NuevaPassword"
                           class="be-form-label">
                    </label>

                    <input asp-for="NuevaPassword"
                           class="be-form-control"
                           autocomplete="new-password"
                           placeholder="Nueva contrasena" />

                    <span asp-validation-for="NuevaPassword"
                          class="be-form-error">
                    </span>
                </div>

                <div class="be-form-field">
                    <label asp-for="ConfirmarPassword"
                           class="be-form-label">
                    </label>

                    <input asp-for="ConfirmarPassword"
                           class="be-form-control"
                           autocomplete="new-password"
                           placeholder="Repite la nueva contrasena" />

                    <span asp-validation-for="ConfirmarPassword"
                          class="be-form-error">
                    </span>
                </div>

                <button type="submit"
                        class="be-btn be-btn-primary be-auth-submit">
                    Restablecer contrasena
                </button>
            </form>

            <div class="be-auth-card-footer">
                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="be-auth-text-link">
                    Solicitar un nuevo token
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="be-auth-text-link">
                    Volver a iniciar sesion
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}