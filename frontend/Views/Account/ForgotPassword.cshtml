@model BembosEvents.Web.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contrasena";
}

<section class="be-auth-page">
    <div class="be-container be-auth-layout">

        <div class="be-auth-promo">
            <span class="be-auth-kicker">
                Bembos Events
            </span>

            <h1>
                Recupera tu acceso
            </h1>

            <p>
                Ingresa tu correo y te enviaremos las instrucciones
                disponibles para restablecer tu contrasena.
            </p>

            <ul class="be-auth-benefits">
                <li>
                    La respuesta no revela si una cuenta existe.
                </li>

                <li>
                    El token de recuperacion es temporal.
                </li>

                <li>
                    Al cambiar la contrasena se revocan las sesiones activas.
                </li>
            </ul>
        </div>

        <div class="be-auth-card">

            @if (
                TempData["PasswordRecoveryRequested"]
                    is string recoveryMessage
            )
            {
                <div class="be-auth-success"
                     role="status">
                    @recoveryMessage
                </div>
            }

            <div class="be-auth-card-heading">
                <span>
                    Seguridad
                </span>

                <h2>
                    Recuperar contrasena
                </h2>

                <p>
                    Escribe el correo asociado a tu cuenta.
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  class="be-auth-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="be-form-summary"
                     role="alert">
                </div>

                <div class="be-form-field">
                    <label asp-for="Correo"
                           class="be-form-label">
                    </label>

                    <input asp-for="Correo"
                           class="be-form-control"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="tu@correo.com" />

                    <span asp-validation-for="Correo"
                          class="be-form-error">
                    </span>
                </div>

                <button type="submit"
                        class="be-btn be-btn-primary be-auth-submit">
                    Enviar instrucciones
                </button>
            </form>

            <div class="be-auth-card-footer">
                <a asp-controller="Account"
                   asp-action="ResetPassword"
                   class="be-auth-text-link">
                    Ya tengo un token de recuperacion
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="be-auth-text-link">
                    Volver a iniciar sesion
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}