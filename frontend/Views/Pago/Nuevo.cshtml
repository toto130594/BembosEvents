@model BembosEvents.Web.ViewModels.NuevoPagoViewModel

@{
    ViewData["Title"] = "Registrar pago";
}

<link rel="stylesheet"
      href="~/css/payment.css"
      asp-append-version="true" />

<main class="be-payment-page">
    <section class="be-payment-shell be-payment-form-shell">
        <div class="be-payment-heading">
            <div>
                <span class="be-payment-kicker">
                    Pago
                </span>

                <h1>
                    Registrar pago
                </h1>

                <p>
                    Reserva @Model.CodigoReserva
                </p>
            </div>

            <a asp-controller="Pago"
               asp-action="PagosReserva"
               asp-route-idReserva="@Model.IdReserva"
               class="btn btn-outline-primary">
                Volver a pagos
            </a>
        </div>

        <section class="be-payment-reservation-summary">
            <div>
                <span>Reserva</span>
                <strong>@Model.CodigoReserva</strong>
            </div>

            <div>
                <span>Estado</span>
                <strong>@Model.EstadoReserva</strong>
            </div>

            <div>
                <span>Monto total</span>
                <strong>
                    S/ @Model.MontoTotal.ToString("N2")
                </strong>
            </div>

            <div>
                <span>Deposito requerido</span>
                <strong>
                    S/ @Model.MontoDeposito.ToString("N2")
                </strong>
            </div>
        </section>

        <section class="be-payment-form-card">
            <form asp-controller="Pago"
                  asp-action="Crear"
                  asp-route-idReserva="@Model.IdReserva"
                  method="post"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="be-payment-field">
                    <label asp-for="Monto">
                        Monto
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            S/
                        </span>

                        <input asp-for="Monto"
                               type="number"
                               min="0.01"
                               step="0.01"
                               inputmode="decimal"
                               class="form-control"
                               autocomplete="off" />
                    </div>

                    <span asp-validation-for="Monto"
                          class="text-danger">
                    </span>
                </div>

                <div class="be-payment-field">
                    <label asp-for="MetodoPago">
                        Metodo de pago
                    </label>

                    <input asp-for="MetodoPago"
                           type="text"
                           maxlength="50"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Ingresa el metodo de pago" />

                    <span asp-validation-for="MetodoPago"
                          class="text-danger">
                    </span>

                    <small class="be-payment-help">
                        El backend acepta texto de hasta 50 caracteres.
                        Selecciona una opcion de pago disponible para continuar.
                    </small>
                </div>

                <div class="be-payment-warning">
                    <strong>
                        Importante
                    </strong>

                    <p>
                        El estado final del pago lo determina Spring Boot.
                        El portal no puede aprobar, rechazar ni reembolsar
                        pagos manualmente.
                    </p>
                </div>

                <div class="be-payment-form-actions">
                    <a asp-controller="Pago"
                       asp-action="PagosReserva"
                       asp-route-idReserva="@Model.IdReserva"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Registrar pago
                    </button>
                </div>
            </form>
        </section>
    </section>
</main>
