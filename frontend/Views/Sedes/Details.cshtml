@model BembosEvents.Web.ViewModels.SedeDetailsViewModel

@{
    ViewData["Title"] =
        Model.Sede.Nombre;

    var tipoLabel =
        Model.Sede.TipoLocal switch
        {
            "FOOD_COURT" =>
                "Food court",

            "EXPRESS" =>
                "Express",

            "DARK_KITCHEN" =>
                "Cocina de despacho",

            "UNIVERSIDAD" =>
                "Universidad",

            _ =>
                "Restaurante"
        };
}

<link rel="stylesheet"
      href="~/css/r4-catalog.css"
      asp-append-version="true" />

<section class="be-r4-detail-hero">
    <div class="be-container">
        <a asp-controller="Sedes"
           asp-action="Index"
           class="be-r4-back">
            â† Volver a locales
        </a>

        <div class="be-r4-detail-grid">
            <div class="be-r4-detail-copy">
                <div class="be-r4-detail-badges">
                    <span class="be-r4-location-type">
                        @tipoLabel
                    </span>

                    @if (Model.Sede.PermiteEventos)
                    {
                        <span class="be-r4-status be-r4-status-events">
                            Disponible para eventos
                        </span>
                    }
                    else
                    {
                        <span class="be-r4-status be-r4-status-info">
                            No habilitado para eventos
                        </span>
                    }
                </div>

                <span class="be-r4-eyebrow">
                    @Model.Sede.Distrito
                </span>

                <h1>
                    @Model.Sede.Nombre
                </h1>

                @if (Model.Sede.PermiteEventos)
                {
                    <p>
                        Este local estÃ¡ habilitado para eventos.
                        Revisa sus espacios disponibles y continÃºa
                        con tu reserva.
                    </p>

                    <a asp-controller="Reserva"
                       asp-action="Index"
                       class="be-r4-primary-link">
                        Iniciar reserva
                    </a>
                }
                else
                {
                    <p>
                        Este punto forma parte del catÃ¡logo de locales,
                        pero actualmente no estÃ¡ habilitado para reservas
                        de eventos en Bembos Events.
                    </p>

                    <a asp-controller="Sedes"
                       asp-action="Index"
                       class="be-r4-secondary-link">
                        Buscar un local para eventos
                    </a>
                }
            </div>

            <aside class="be-r4-detail-info">
                <span>
                    InformaciÃ³n del local
                </span>

                <dl>
                    <div>
                        <dt>DirecciÃ³n</dt>
                        <dd>@Model.Sede.Direccion</dd>
                    </div>

                    <div>
                        <dt>Distrito</dt>
                        <dd>@Model.Sede.Distrito</dd>
                    </div>

                    <div>
                        <dt>Tipo</dt>
                        <dd>@tipoLabel</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Sede.Telefono))
                    {
                        <div>
                            <dt>TelÃ©fono</dt>
                            <dd>@Model.Sede.Telefono</dd>
                        </div>
                    }
                </dl>
            </aside>
        </div>
    </div>
</section>

@if (Model.Sede.PermiteEventos)
{
    <section class="be-r4-spaces-section">
        <div class="be-container">
            <div class="be-r4-section-heading">
                <div>
                    <span>
                        Espacios para tu celebraciÃ³n
                    </span>

                    <h2>
                        Salones disponibles
                    </h2>
                </div>

                <p>
                    Elige el espacio que mejor se adapte
                    a la cantidad de invitados de tu evento.
                </p>
            </div>

            @if (Model.Salones.Count == 0)
            {
                <div class="be-r4-empty">
                    <h3>
                        AÃºn no hay espacios disponibles
                    </h3>

                    <p>
                        Este local estÃ¡ habilitado para eventos,
                        pero actualmente no tiene salones publicados.
                    </p>
                </div>
            }
            else
            {
                <div class="be-r4-space-grid">
                    @foreach (var salon in Model.Salones)
                    {
                        <article class="be-r4-space-card">
                            <span>
                                Hasta @salon.Capacidad personas
                            </span>

                            <h3>
                                @salon.Nombre
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(salon.Descripcion))
                            {
                                <p>
                                    @salon.Descripcion
                                </p>
                            }
                            else
                            {
                                <p>
                                    Espacio disponible para celebrar
                                    y personalizar tu evento.
                                </p>
                            }

                            <a asp-controller="Salones"
                               asp-action="Details"
                               asp-route-idSalon="@salon.IdSalon">
                                Ver salÃ³n
                            </a>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    <section class="be-r4-spaces-section">
        <div class="be-container">
            <div class="be-r4-info-notice">
                <strong>
                    Este local no estÃ¡ habilitado para reservas de eventos
                </strong>

                <p>
                    Puedes consultar sus datos aquÃ­ o regresar al catÃ¡logo
                    para encontrar uno de los locales disponibles para eventos.
                </p>

                <a asp-controller="Sedes"
                   asp-action="Index">
                    Ver locales
                </a>
            </div>
        </div>
    </section>
}