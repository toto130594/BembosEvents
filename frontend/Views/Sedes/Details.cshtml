@model BembosEvents.Web.ViewModels.SedeDetailsViewModel

@{
    ViewData["Title"] = Model.Sede.Nombre;
}

<section class="be-r5-sede-hero be-r5-banner">
    <div class="be-container">
        <a asp-controller="Sedes"
           asp-action="Index"
           class="be-r5-back-link">
            ← VOLVER A LOCALES
        </a>

        <div class="be-r5-sede-hero-grid">
            <div class="be-r5-sede-hero-copy">
                <span class="be-r5-banner-kicker">
                    @Model.Sede.Distrito
                </span>

                <h1>
                    TU FIESTA
                    <span>EMPIEZA EN</span>
                    <strong>@Model.Sede.Nombre</strong>
                </h1>

                <p>
                    Conoce los datos del local y elige uno de sus salones
                    disponibles para continuar con tu celebracion.
                </p>
            </div>

            <div class="be-r5-sede-hero-photo">
                <span>@Model.Sede.Nombre</span>
            </div>
        </div>
    </div>
</section>

<section class="be-r5-sede-info">
    <div class="be-container">
        <div class="be-r5-section-heading">
            <span>CONOCE ESTA SEDE</span>
            <h2>@Model.Sede.Nombre</h2>
        </div>

        <div class="be-r5-sede-info-grid">
            <div class="be-r5-sede-photo-card">
                <div class="be-r5-sede-photo"></div>

                <div class="be-r5-sede-photo-caption">
                    <span>LOCAL BEMBOS EVENTS</span>
                    <strong>@Model.Sede.Distrito</strong>
                </div>
            </div>

            <aside class="be-r5-sede-data">
                <span class="be-r5-data-eyebrow">
                    INFORMACION DEL LOCAL
                </span>

                <dl>
                    <div>
                        <dt>Direccion</dt>
                        <dd>@Model.Sede.Direccion</dd>
                    </div>

                    <div>
                        <dt>Distrito</dt>
                        <dd>@Model.Sede.Distrito</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Sede.Telefono))
                    {
                        <div>
                            <dt>Telefono</dt>
                            <dd>@Model.Sede.Telefono</dd>
                        </div>
                    }
                </dl>

                <a asp-controller="Reserva"
                   asp-action="Index"
                   class="be-r5-reserve-cta">
                    RESERVA AQUI
                </a>
            </aside>
        </div>
    </div>
</section>

<section class="be-r5-salones">
    <div class="be-container">
        <div class="be-r5-section-heading be-r5-section-heading-row">
            <div>
                <span>SALONES DISPONIBLES</span>
                <h2>ELIGE TU ESPACIO</h2>
            </div>

            <p>
                Revisa la capacidad y entra al detalle del salon
                que mejor se adapte a tu celebracion.
            </p>
        </div>

        @if (Model.Salones.Count == 0)
        {
            <div class="be-r5-empty">
                <h3>No hay salones disponibles</h3>
                <p>
                    Esta sede aun no tiene salones publicos disponibles.
                </p>
            </div>
        }
        else
        {
            <div class="be-r5-salon-list">
                @foreach (var salon in Model.Salones)
                {
                    <article class="be-r5-salon-card">
                        <div class="be-r5-salon-photo">
                            <span>
                                HASTA @salon.Capacidad PERSONAS
                            </span>
                        </div>

                        <div class="be-r5-salon-copy">
                            <span class="be-r5-salon-eyebrow">
                                @Model.Sede.Distrito
                            </span>

                            <h3>@salon.Nombre</h3>

                            @if (!string.IsNullOrWhiteSpace(salon.Descripcion))
                            {
                                <p>@salon.Descripcion</p>
                            }
                            else
                            {
                                <p>
                                    Un espacio preparado para celebrar en Bembos
                                    con comodidad y una experiencia divertida.
                                </p>
                            }

                            <div class="be-r5-salon-footer">
                                <span>
                                    Capacidad: @salon.Capacidad personas
                                </span>

                                <a asp-controller="Salones"
                                   asp-action="Details"
                                   asp-route-idSalon="@salon.IdSalon">
                                    VER SALON →
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>