@model BembosEvents.Web.ViewModels.SedesIndexViewModel

@{
    ViewData["Title"] = "Locales";
}

<section class="be-editorial-banner be-editorial-locations">
    <div class="be-container be-editorial-banner-inner">
        <div class="be-editorial-copy">
            <span class="be-editorial-eyebrow">
                Encuentra tu Bembos
            </span>

            <h1>
                ELIGE DONDE
                <strong>CELEBRAR</strong>
            </h1>

            <p>
                Revisa nuestras sedes disponibles y empieza
                tu reserva desde el lugar ideal para tu evento.
            </p>

            <a asp-controller="Reserva"
               asp-action="Index"
               class="be-editorial-cta">
                Reservar evento
            </a>
        </div>

        <div class="be-editorial-art be-location-art-banner"
             aria-hidden="true">
            <div class="be-map-pin be-map-pin-a">
                <span></span>
            </div>

            <div class="be-map-pin be-map-pin-b">
                <span></span>
            </div>

            <div class="be-map-pin be-map-pin-c">
                <span></span>
            </div>

            <strong class="be-location-banner-word">
                LIMA
            </strong>
        </div>
    </div>
</section>

<section class="be-store-section be-store-section-soft">
    <div class="be-container">
        <div class="be-store-heading">
            <div>
                <span class="be-store-kicker">
                    Locales Bembos Events
                </span>

                <h2>
                    ENCUENTRA TU SEDE
                </h2>
            </div>
        </div>

        @if (Model.Sedes.Count == 0)
        {
            <div class="be-designed-empty be-designed-empty-locations">
                <span class="be-designed-empty-mark">
                    ●
                </span>

                <div>
                    <h3>
                        No hay locales activos por el momento
                    </h3>

                    <p>
                        Cuando existan sedes disponibles apareceran aqui
                        con direccion, distrito y datos de contacto.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index">
                        Volver al inicio
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="be-location-grid">
                @foreach (var sede in Model.Sedes)
                {
                    <article class="be-location-card be-location-card-premium">
                        <div class="be-location-art">
                            <span>
                                @sede.Distrito
                            </span>

                            <strong>
                                @sede.Nombre
                            </strong>

                            <i class="be-location-ring"
                               aria-hidden="true"></i>
                        </div>

                        <div class="be-location-copy">
                            <div class="be-location-meta">
                                <span>
                                    Direccion
                                </span>

                                <p>
                                    @sede.Direccion
                                </p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(sede.Telefono))
                            {
                                <div class="be-location-meta">
                                    <span>
                                        Telefono
                                    </span>

                                    <p>
                                        @sede.Telefono
                                    </p>
                                </div>
                            }

                            <a asp-controller="Sedes"
                               asp-action="Details"
                               asp-route-idSede="@sede.IdSede">
                                Conocer local
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="be-explore-bottom-cta be-explore-bottom-cta-blue">
    <div class="be-container">
        <div>
            <span>
                Tu local ya esta
            </span>

            <strong>
                Ahora arma tu evento
            </strong>
        </div>

        <a asp-controller="Paquetes"
           asp-action="Index">
            Ver paquetes
        </a>
    </div>
</section>