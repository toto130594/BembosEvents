@model BembosEvents.Web.ViewModels.SedesIndexViewModel

@{
    ViewData["Title"] = "Sedes";
}

<section class="be-catalog-hero">
    <div class="be-container be-catalog-hero-content">
        <span class="be-catalog-kicker">
            Bembos Events
        </span>

        <h1>
            Elige la sede para tu celebracion
        </h1>

        <p>
            Consulta las sedes disponibles y entra a cada una
            para conocer sus salones reales.
        </p>
    </div>
</section>

<section class="be-catalog-section"
         id="salones-por-sede">
    <div class="be-container">

        <div class="be-section-heading">
            <div>
                <span class="be-catalog-kicker">
                    Nuestras sedes
                </span>

                <h2>
                    Encuentra el local ideal
                </h2>
            </div>

            <p>
                Los salones se muestran segun la sede seleccionada.
            </p>
        </div>

        @if (Model.Sedes.Count == 0)
        {
            <div class="be-catalog-empty">
                <h3>
                    Aun no hay sedes disponibles
                </h3>

                <p>
                    Cuando existan sedes activas apareceran aqui.
                </p>
            </div>
        }
        else
        {
            <div class="be-catalog-grid">
                @foreach (var sede in Model.Sedes)
                {
                    <article class="be-catalog-card">
                        <div class="be-catalog-card-accent"></div>

                        <div class="be-catalog-card-body">
                            <span class="be-catalog-eyebrow">
                                @sede.Distrito
                            </span>

                            <h3>
                                @sede.Nombre
                            </h3>

                            <dl class="be-catalog-facts">
                                <div>
                                    <dt>
                                        Direccion
                                    </dt>

                                    <dd>
                                        @sede.Direccion
                                    </dd>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(sede.Telefono))
                                {
                                    <div>
                                        <dt>
                                            Telefono
                                        </dt>

                                        <dd>
                                            @sede.Telefono
                                        </dd>
                                    </div>
                                }
                            </dl>
                        </div>

                        <div class="be-catalog-card-footer">
                            <a asp-controller="Sedes"
                               asp-action="Details"
                               asp-route-idSede="@sede.IdSede"
                               class="be-btn be-btn-primary">
                                Ver sede y salones
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
