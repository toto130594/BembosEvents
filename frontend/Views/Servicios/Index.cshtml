@model IReadOnlyList<BembosEvents.Web.Models.Api.ServicioAdicionalPublicoDto>

@{
    ViewData["Title"] = "Servicios";
}

<section class="be-catalog-hero">
    <div class="be-container be-catalog-hero-content">
        <span class="be-catalog-kicker">
            Bembos Events
        </span>

        <h1>
            Servicios adicionales
        </h1>

        <p>
            Complementa tu celebracion con los servicios adicionales
            disponibles en el catalogo.
        </p>
    </div>
</section>

<section class="be-catalog-section">
    <div class="be-container">

        <div class="be-section-heading">
            <div>
                <span class="be-catalog-kicker">
                    Servicios
                </span>

                <h2>
                    Agrega extras a tu evento
                </h2>
            </div>

            <p>
                Los servicios y precios mostrados provienen
                directamente de Spring Boot.
            </p>
        </div>

        @if (Model.Count == 0)
        {
            <div class="be-catalog-empty">
                <h3>
                    Aun no hay servicios adicionales disponibles
                </h3>

                <p>
                    Cuando existan servicios activos apareceran aqui.
                </p>
            </div>
        }
        else
        {
            <div class="be-catalog-grid">
                @foreach (var servicio in Model)
                {
                    <article class="be-catalog-card">
                        <div class="be-catalog-card-accent"></div>

                        <div class="be-catalog-card-body">
                            <span class="be-catalog-eyebrow">
                                Servicio adicional
                            </span>

                            <h3>
                                @servicio.Nombre
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                            {
                                <p>
                                    @servicio.Descripcion
                                </p>
                            }

                            <div class="be-catalog-price">
                                <small>
                                    Precio
                                </small>

                                <strong>
                                    S/ @servicio.Precio.ToString("0.00")
                                </strong>
                            </div>
                        </div>

                        <div class="be-catalog-card-footer">
                            <a asp-controller="Servicios"
                               asp-action="Details"
                               asp-route-idServicioAdicional="@servicio.IdServicioAdicional"
                               class="be-btn be-btn-primary">
                                Ver servicio
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
