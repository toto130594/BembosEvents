@model BembosEvents.Web.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Inicio";
}

<section class="be-r6-hero be-r6-banner">
    <div class="be-r6-hero-overlay"></div>

    <div class="be-container be-r6-hero-inner">
        <div class="be-r6-hero-copy">
            <span class="be-r6-hero-kicker">
                BEMBOS EVENTS
            </span>

            <h1>
                TU FIESTA.
                <strong>TU MOMENTO.</strong>
            </h1>

            <p>
                Celebra en grande con espacios, tematicas y paquetes
                preparados para convertir cada momento en una
                experiencia inolvidable.
            </p>

            <div class="be-r6-hero-actions">
                <a class="be-r6-hero-primary"
                   asp-controller="Reserva"
                   asp-action="Index">
                    Comienza tu evento
                </a>

                <a class="be-r6-hero-secondary"
                   asp-controller="Paquetes"
                   asp-action="Index">
                    Ver paquetes
                </a>
            </div>
        </div>

        <div class="be-r6-hero-note">
            <span class="be-r6-hero-note-icon"
                  aria-hidden="true"></span>

            <strong>Hazlo inolvidable</strong>
            <small>Fiestas que se sienten diferentes.</small>
        </div>
    </div>
</section>

<section class="be-category-ribbon">
    <div class="be-container">
        <div class="be-category-ribbon-grid">
            <a asp-controller="Paquetes" asp-action="Index">
                <span class="be-ribbon-disc">P</span>
                <strong>Paquetes</strong>
            </a>

            <a asp-controller="Sedes" asp-action="Index">
                <span class="be-ribbon-disc">L</span>
                <strong>Locales</strong>
            </a>

            <a asp-controller="Tematicas" asp-action="Index">
                <span class="be-ribbon-disc">T</span>
                <strong>Tematicas</strong>
            </a>

            <a asp-controller="Servicios" asp-action="Index">
                <span class="be-ribbon-disc">+</span>
                <strong>Servicios</strong>
            </a>
        </div>
    </div>
</section>

@if (Model.HasPartialLoadError)
{
    <section class="be-home-notice"
             role="status">
        <div class="be-container">
            <div class="be-home-notice-box">
                Algunos catalogos no pudieron cargarse.
                Puedes seguir navegando con la informacion disponible.
            </div>
        </div>
    </section>
}

<section id="paquetes"
         class="be-store-section">
    <div class="be-container">
        <div class="be-store-heading">
            <div>
                <span class="be-store-kicker">
                    Arma tu celebracion
                </span>

                <h2>
                    PAQUETES QUE SE ADAPTAN A TU EVENTO
                </h2>
            </div>

            <a asp-controller="Paquetes"
               asp-action="Index"
               class="be-store-heading-link">
                Ver todos
            </a>
        </div>

        @if (!Model.PaquetesApiAvailable)
        {
            <div class="be-empty-state">
                <h3>No pudimos cargar los paquetes</h3>
                <p>Intenta nuevamente en unos minutos.</p>
            </div>
        }
        else if (Model.Paquetes.Count == 0)
        {
            <div class="be-empty-state">
                <h3>Aun no hay paquetes disponibles</h3>
            </div>
        }
        else
        {
            <div class="be-product-grid">
                @foreach (var paquete in Model.Paquetes.Take(3))
                {
                    var tone = paquete.IdPaquete % 3;

                    <article class="be-product-card">
                        <div class="be-product-art be-tone-@tone">
                            <span class="be-product-pill">
                                @paquete.CantidadPersonasBase personas
                            </span>

                            <div class="be-product-mini-burger"
                                 aria-hidden="true">
                                <i></i>
                                <i></i>
                                <i></i>
                                <i></i>
                            </div>

                            <strong>
                                BEMBOS
                                <small>EVENTS</small>
                            </strong>
                        </div>

                        <div class="be-product-body">
                            <h3>
                                @paquete.Nombre
                            </h3>

                            <p>
                                @(string.IsNullOrWhiteSpace(paquete.Descripcion)
                                    ? "Una opcion lista para personalizar con sede, salon, tematica y servicios."
                                    : paquete.Descripcion)
                            </p>

                            <div class="be-product-price">
                                <span>Desde</span>
                                <strong>
                                    S/ @paquete.PrecioBase.ToString("0.00")
                                </strong>
                            </div>

                            <a asp-controller="Paquetes"
                               asp-action="Details"
                               asp-route-idPaquete="@paquete.IdPaquete"
                               class="be-product-button">
                                Ver paquete
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="be-r6-official-promo"
         aria-label="Bembos para eventos">
    <a asp-controller="Reserva"
       asp-action="Index"
       class="be-r6-official-promo-link"
       aria-label="Cotiza tu evento con Bembos">
        <img src="~/images/bembos-events-r6/events-desktop.webp"
             alt="Dale sabor a tus eventos - Cotiza aqui"
             class="be-r6-official-promo-image" />
    </a>
</section>

<section id="sedes"
         class="be-store-section be-store-section-soft">
    <div class="be-container">
        <div class="be-store-heading">
            <div>
                <span class="be-store-kicker">
                    Encuentra tu Bembos
                </span>

                <h2>
                    ELIGE DONDE CELEBRAR
                </h2>
            </div>

            <a asp-controller="Sedes"
               asp-action="Index"
               class="be-store-heading-link">
                Ver locales
            </a>
        </div>

        @if (!Model.SedesApiAvailable)
        {
            <div class="be-empty-state">
                <h3>No pudimos cargar los locales</h3>
            </div>
        }
        else
        {
            <div class="be-location-grid">
                @foreach (var sede in Model.Sedes.Take(3))
                {
                    <article class="be-location-card">
                        <div class="be-location-art">
                            <span>
                                @sede.Distrito
                            </span>

                            <strong>
                                @sede.Nombre
                            </strong>
                        </div>

                        <div class="be-location-copy">
                            <p>
                                @sede.Direccion
                            </p>

                            <a asp-controller="Sedes"
                               asp-action="Details"
                               asp-route-idSede="@sede.IdSede">
                                Conocer local
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="be-split-promos">
    <div class="be-container be-split-promos-grid">

        <article class="be-split-card be-split-card-blue">
            <div class="be-split-art">
                <span>★</span>
            </div>

            <div class="be-split-copy">
                <small>
                    Personaliza tu evento
                </small>

                <h2>
                    TEMATICAS
                </h2>

                <p>
                    Elige una ambientacion y dale una identidad propia
                    a tu celebracion.
                </p>

                <a asp-controller="Tematicas"
                   asp-action="Index">
                    Descubrelas aqui
                </a>
            </div>
        </article>

        <article class="be-split-card be-split-card-yellow">
            <div class="be-split-art">
                <span>+</span>
            </div>

            <div class="be-split-copy">
                <small>
                    Completa la experiencia
                </small>

                <h2>
                    SERVICIOS
                </h2>

                <p>
                    Agrega opciones adicionales durante tu reserva
                    y arma el evento a tu manera.
                </p>

                <a asp-controller="Servicios"
                   asp-action="Index">
                    Ver servicios
                </a>
            </div>
        </article>
    </div>
</section>

<section id="como-funciona"
         class="be-how-section">
    <div class="be-container">
        <div class="be-store-heading be-store-heading-centered">
            <div>
                <span class="be-store-kicker">
                    Sin complicaciones
                </span>

                <h2>
                    TU EVENTO EN 4 PASOS
                </h2>
            </div>
        </div>

        <ol class="be-how-grid">
            <li>
                <span>1</span>
                <strong>Elige tu local</strong>
                <p>Escoge la sede que mejor te convenga.</p>
            </li>

            <li>
                <span>2</span>
                <strong>Selecciona salon</strong>
                <p>Revisa los espacios disponibles.</p>
            </li>

            <li>
                <span>3</span>
                <strong>Personaliza</strong>
                <p>Paquete, tematica y servicios adicionales.</p>
            </li>

            <li>
                <span>4</span>
                <strong>Confirma</strong>
                <p>Revisa el resumen y completa tu reserva.</p>
            </li>
        </ol>
    </div>
</section>

<section class="be-faq-section">
    <div class="be-container">
        <div class="be-store-heading be-store-heading-centered">
            <div>
                <span class="be-store-kicker">
                    Preguntas frecuentes
                </span>

                <h2>
                    TODO LO QUE NECESITAS SABER
                </h2>
            </div>
        </div>

        <div class="be-faq-grid">
            <details>
                <summary>
                    ¿Como empiezo una reserva?
                </summary>

                <p>
                    Selecciona “Reservar”, elige sede, salon, fecha
                    y continua con la personalizacion de tu evento.
                </p>
            </details>

            <details>
                <summary>
                    ¿Puedo elegir una tematica?
                </summary>

                <p>
                    Si. Las tematicas activas aparecen dentro del flujo
                    de reserva para que puedas personalizar tu celebracion.
                </p>
            </details>

            <details>
                <summary>
                    ¿El precio mostrado es el precio final?
                </summary>

                <p>
                    Es el precio base del paquete. El total puede cambiar
                    segun la configuracion y servicios adicionales elegidos.
                </p>
            </details>

            <details>
                <summary>
                    ¿Puedo revisar mis reservas?
                </summary>

                <p>
                    Si has iniciado sesion puedes consultar tus reservas
                    desde la opcion “Mis reservas”.
                </p>
            </details>
        </div>
    </div>
</section>

<section id="reservar"
         class="be-final-booking">
    <div class="be-container be-final-booking-content">
        <div>
            <span>
                Bembos Events
            </span>

            <h2>
                ¿LISTO PARA ARMAR TU FIESTA?
            </h2>
        </div>

        <a asp-controller="Reserva"
           asp-action="Index">
            Empezar reserva
        </a>
    </div>
</section>
