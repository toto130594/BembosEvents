@model BembosEvents.Web.ViewModels.ChatDetailViewModel

@{
    ViewData["Title"] = $"Chat #{Model.Conversacion.IdConversacion}";

    var stateClass =
        Model.Conversacion.Estado.ToLowerInvariant()
            .Replace("_", "-");

    var isBot =
        Model.Conversacion.Estado == "BOT";

    var maxMessageLength =
        isBot
            ? 2000
            : 4000;

    var messagePlaceholder =
        isBot
            ? "Pregunta por disponibilidad, recomendaciones o tu reserva..."
            : "Escribe aqui...";
}

<link rel="stylesheet"
      href="~/css/chat.css"
      asp-append-version="true" />

<section class="chat-page">
    <div class="be-container">
        <header class="chat-thread-header">
            <div>
                <a asp-action="Index"
                   class="chat-back-link">
                    ← Mis conversaciones
                </a>

                <span class="chat-kicker">
                    Conversacion
                </span>

                <h1>
                    Chat #@Model.Conversacion.IdConversacion
                </h1>

                <p>
                    Sede:
                    <strong>
                        @(Model.Conversacion.IdSede?.ToString() ?? "No asociada")
                    </strong>
                </p>
            </div>

            <span class="chat-state chat-state--@stateClass">
                @Model.Conversacion.Estado.Replace("_", " ")
            </span>
        </header>

        @if (TempData["ChatError"] is string error)
        {
            <div class="chat-alert chat-alert--error">@error</div>
        }

        @if (TempData["ChatSuccess"] is string success)
        {
            <div class="chat-alert chat-alert--success">@success</div>
        }

        @if (isBot)
        {
            <section class="chat-ai-guide"
                     data-chat-ai-guide>
                <div class="chat-ai-guide__heading">
                    <div>
                        <span class="chat-kicker">
                            Asistente inteligente
                        </span>

                        <h2>
                            Puedo ayudarte dentro del flujo seguro de Bembos Events
                        </h2>
                    </div>

                    <span class="chat-ai-badge">
                        IA + reglas del backend
                    </span>
                </div>

                <p class="chat-ai-guide__intro">
                    Puedes consultar informacion, pedir recomendaciones,
                    revisar disponibilidad y preparar una reserva.
                    Los precios, disponibilidad y la creacion final
                    siempre los valida Spring Boot.
                </p>

                <div class="chat-ai-suggestions"
                     aria-label="Sugerencias de mensajes">
                    <button type="button"
                            class="chat-suggestion"
                            data-chat-suggestion="¿Cómo funciona una reserva?">
                        Como funciona una reserva
                    </button>

                    <button type="button"
                            class="chat-suggestion"
                            data-chat-suggestion="Recomiéndame un paquete para 30 invitados">
                        Recomendar paquete
                    </button>

                    <button type="button"
                            class="chat-suggestion"
                            data-chat-suggestion="¿Qué necesito para preparar una reserva?">
                        Que necesito para reservar
                    </button>
                </div>

                <details class="chat-ai-formats">
                    <summary>
                        Ver formatos para consultas avanzadas
                    </summary>

                    <div class="chat-ai-formats__body">
                        <p>
                            <strong>Disponibilidad:</strong>
                            <code>
                                Hay disponibilidad en salon 8 el 20/11/2026 de 16:00 a 18:00?
                            </code>
                        </p>

                        <p>
                            <strong>Preparar borrador:</strong>
                            <code>
                                Para mi reserva sede 3 salon 8, 25 invitados,
                                20/11/2026 de 16:00 a 18:00, paquete 2
                            </code>
                        </p>

                        <p>
                            La confirmacion de una reserva real requiere
                            una solicitud explicita y el backend vuelve
                            a validar las reglas de negocio.
                        </p>

                        <p>
                            Cuando una respuesta incluye
                            <code>Fuentes: kb://...</code>,
                            corresponde a informacion recuperada
                            de la base publica de conocimiento.
                        </p>
                    </div>
                </details>
            </section>
        }

        <section class="chat-thread"
                 data-chat-history-url="@Url.Action(
                    "HistoryJson",
                    "Chat",
                    new
                    {
                        idConversacion =
                            Model.Conversacion.IdConversacion
                    })">

            <div class="chat-messages"
                 data-chat-messages>
                @foreach (var message in Model.Conversacion.Mensajes)
                {
                    var senderClass =
                        message.TipoEmisor.ToLowerInvariant()
                            .Replace("_", "-");

                    <article class="chat-message chat-message--@senderClass">
                        <div class="chat-message__meta">
                            <strong>
                                @message.TipoEmisor.Replace("_", " ")
                            </strong>

                            <time>
                                @message.FechaEnvio.ToString("dd/MM/yyyy HH:mm")
                            </time>
                        </div>

                        <p>@message.Contenido</p>
                    </article>
                }
            </div>
        </section>

        @if (Model.Conversacion.Estado != "CERRADO")
        {
            <form asp-action="SendMessage"
                  asp-route-idConversacion="@Model.Conversacion.IdConversacion"
                  method="post"
                  class="chat-composer"
                  data-chat-composer
                  data-chat-ai-mode="@isBot.ToString().ToLowerInvariant()">
                @Html.AntiForgeryToken()

                <label for="contenido">
                    Tu mensaje
                </label>

                <textarea id="contenido"
                          name="contenido"
                          maxlength="@maxMessageLength"
                          rows="3"
                          required
                          data-chat-input
                          placeholder="@messagePlaceholder"></textarea>

                <div class="chat-composer-meta">
                    <span data-chat-character-count
                          aria-live="polite">
                        0 / @maxMessageLength
                    </span>

                    @if (isBot)
                    {
                        <span>
                            Las operaciones reales siguen sujetas
                            a validacion del backend.
                        </span>
                    }
                </div>

                @if (isBot)
                {
                    <div class="chat-confirmation-notice"
                         data-chat-confirmation-notice
                         hidden>
                        Una confirmacion explicita puede crear una
                        reserva real si el borrador cumple todas las reglas.
                    </div>
                }

                <button type="submit"
                        class="chat-primary-button"
                        data-chat-submit>
                    Enviar
                </button>
            </form>
        }

        @if (
            Model.Conversacion.Estado == "BOT" &&
            Model.Conversacion.IdSede.HasValue
        )
        {
            <form asp-action="Escalate"
                  asp-route-idConversacion="@Model.Conversacion.IdConversacion"
                  method="post"
                  class="chat-escalation">
                @Html.AntiForgeryToken()

                <div>
                    <strong>
                        ¿Necesitas una persona?
                    </strong>

                    <span>
                        Solicita atencion de un encargado de esta sede.
                    </span>
                </div>

                <button type="submit"
                        class="chat-secondary-button">
                    Solicitar encargado
                </button>
            </form>
        }
        else if (
            Model.Conversacion.Estado == "BOT" &&
            !Model.Conversacion.IdSede.HasValue
        )
        {
            <div class="chat-info">
                Esta conversacion no tiene sede y no puede escalarse
                a un encargado.
            </div>
        }
        else if (
            Model.Conversacion.Estado == "ESPERANDO_ENCARGADO"
        )
        {
            <div class="chat-info">
                Tu solicitud esta en la cola de atencion de la sede.
            </div>
        }
        else if (
            Model.Conversacion.Estado == "EN_ATENCION"
        )
        {
            <div class="chat-info">
                Un encargado de la sede puede responder esta conversacion.
            </div>
        }
    </div>
</section>

<script src="~/js/chat.js"
        asp-append-version="true"></script>