@model IReadOnlyList<BembosEvents.Web.Models.Api.TematicaPublicaDto>

@{
    ViewData["Title"] = "Tematicas";
}

<section class="be-catalog-hero">
    <div class="be-container be-catalog-hero-content">
        <span class="be-catalog-kicker">
            Bembos Events
        </span>

        <h1>
            Dale una tematica a tu fiesta
        </h1>

        <p>
            Explora las tematicas configuradas para personalizar
            tu celebracion.
        </p>
    </div>
</section>

<section class="be-catalog-section">
    <div class="be-container">

        <div class="be-section-heading">
            <div>
                <span class="be-catalog-kicker">
                    Tematicas
                </span>

                <h2>
                    Personaliza tu evento
                </h2>
            </div>

            <p>
                Los precios adicionales provienen directamente
                del catalogo administrado por Bembos Events.
            </p>
        </div>

        @if (Model.Count == 0)
        {
            <div class="be-catalog-empty">
                <h3>
                    Aun no hay tematicas disponibles
                </h3>

                <p>
                    Cuando existan tematicas activas apareceran aqui.
                </p>
            </div>
        }
        else
        {
            <div class="be-catalog-grid">
                @foreach (var tematica in Model)
                {
                    <article class="be-catalog-card">
                        <div class="be-catalog-card-accent"></div>

                        <div class="be-catalog-card-body">
                            <span class="be-catalog-eyebrow">
                                Tematica
                            </span>

                            <h3>
                                @tematica.Nombre
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(tematica.Descripcion))
                            {
                                <p>
                                    @tematica.Descripcion
                                </p>
                            }

                            <div class="be-catalog-price">
                                <small>
                                    Adicional
                                </small>

                                <strong>
                                    S/ @tematica.PrecioAdicional.ToString("0.00")
                                </strong>
                            </div>
                        </div>

                        <div class="be-catalog-card-footer">
                            <a asp-controller="Tematicas"
                               asp-action="Details"
                               asp-route-idTematica="@tematica.IdTematica"
                               class="be-btn be-btn-primary">
                                Ver tematica
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
