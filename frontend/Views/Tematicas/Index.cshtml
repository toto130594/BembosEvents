@model IReadOnlyList<BembosEvents.Web.Models.Api.TematicaPublicaDto>

@{
    ViewData["Title"] = "Tematicas";
}

<section class="be-editorial-banner be-editorial-themes">
    <div class="be-container be-editorial-banner-inner">
        <div class="be-editorial-copy">
            <span class="be-editorial-eyebrow">
                Dale personalidad
            </span>

            <h1>
                TEMATICAS QUE
                <strong>TRANSFORMAN</strong>
            </h1>

            <p>
                Elige una ambientacion y convierte tu reserva
                en una celebracion con identidad propia.
            </p>

            <a asp-controller="Reserva"
               asp-action="Index"
               class="be-editorial-cta">
                Personalizar evento
            </a>
        </div>

        <div class="be-editorial-art be-theme-art"
             aria-hidden="true">
            <span class="be-theme-word be-theme-word-a">COLOR</span>
            <span class="be-theme-word be-theme-word-b">FIESTA</span>
            <span class="be-theme-word be-theme-word-c">WOW!</span>
            <i class="be-theme-shape be-theme-shape-a"></i>
            <i class="be-theme-shape be-theme-shape-b"></i>
            <i class="be-theme-shape be-theme-shape-c"></i>
        </div>
    </div>
</section>

<section class="be-store-section">
    <div class="be-container">
        <div class="be-store-heading">
            <div>
                <span class="be-store-kicker">
                    Personaliza tu evento
                </span>

                <h2>
                    ELIGE UNA TEMATICA
                </h2>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="be-designed-empty be-designed-empty-themes">
                <span class="be-designed-empty-mark">
                    ✦
                </span>

                <div>
                    <h3>
                        Estamos preparando nuevas tematicas
                    </h3>

                    <p>
                        Cuando existan tematicas activas apareceran aqui.
                        La pagina mantiene su experiencia visual incluso
                        mientras el catalogo esta vacio.
                    </p>

                    <a asp-controller="Paquetes"
                       asp-action="Index">
                        Ver paquetes
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="be-explore-grid">
                @foreach (var tematica in Model)
                {
                    var tone = tematica.IdTematica % 4;

                    <article class="be-explore-card be-explore-theme be-explore-tone-@tone">
                        <div class="be-explore-card-art">
                            <span>
                                TEMATICA
                            </span>

                            <strong>
                                @tematica.Nombre
                            </strong>

                            <i></i>
                            <i></i>
                            <i></i>
                        </div>

                        <div class="be-explore-card-body">
                            <h3>@tematica.Nombre</h3>

                            <p>
                                @(string.IsNullOrWhiteSpace(tematica.Descripcion)
                                    ? "Ambientacion disponible para personalizar tu evento."
                                    : tematica.Descripcion)
                            </p>

                            <div class="be-explore-card-footer">
                                <span>Adicional</span>

                                <strong>
                                    S/ @tematica.PrecioAdicional.ToString("0.00")
                                </strong>
                            </div>

                            <a asp-controller="Tematicas"
                               asp-action="Details"
                               asp-route-idTematica="@tematica.IdTematica">
                                Ver tematica
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="be-explore-bottom-cta be-explore-bottom-cta-pink">
    <div class="be-container">
        <div>
            <span>
                ¿Ya tienes una idea?
            </span>

            <strong>
                Llevala a tu reserva
            </strong>
        </div>

        <a asp-controller="Reserva"
           asp-action="Index">
            Empezar ahora
        </a>
    </div>
</section>
