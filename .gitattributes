# Normalizar archivos de texto en Git
* text=auto

# Documentación y configuración
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Linux / Bash / Docker
*.sh text eol=lf
Dockerfile text eol=lf

# Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf